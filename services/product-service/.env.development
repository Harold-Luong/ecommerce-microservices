# Chỉ dùng cho development local. Không dùng các giá trị này ở môi trường thật.
NODE_ENV=development
PORT=3002

DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_db
DB_USER=product
DB_PASSWORD=product

# Phải giống JWT_ACCESS_SECRET trong auth-service/.env.development.
JWT_ACCESS_SECRET=dev-only-access-secret-change-for-your-team
