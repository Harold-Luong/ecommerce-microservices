# Chỉ dùng cho development local. Không dùng các giá trị này ở môi trường thật.
NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=auth_password

JWT_ACCESS_SECRET=dev-only-access-secret-change-for-your-team
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-for-your-team
JWT_REFRESH_EXPIRES_IN=30d

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=password123
